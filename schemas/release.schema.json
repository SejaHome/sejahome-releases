{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sejahome.local/schemas/release-v1.json",
  "title": "Manifesto de release SejaHome",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "product",
    "version",
    "state",
    "basedOn",
    "publishedAt",
    "builtAt",
    "commit",
    "artifacts",
    "compatibility",
    "migrations",
    "rollback",
    "knownIssues",
    "audiences",
    "actionRequired",
    "publicLinks",
    "approval"
  ],
  "properties": {
    "schema": { "const": 1 },
    "product": { "type": "string", "minLength": 1, "maxLength": 80 },
    "version": {
      "type": "string",
      "pattern": "^[0-9]{4}\\.(0[1-9]|1[0-2])\\.(0[1-9]|[1-9][0-9])(?:(?:~rc[1-9][0-9]*)|(?:-rc\\.[1-9][0-9]*))?$"
    },
    "state": { "enum": ["draft", "rc", "candidate", "stable"] },
    "basedOn": { "type": "string" },
    "publishedAt": { "$ref": "#/$defs/utcTimestamp" },
    "builtAt": { "$ref": "#/$defs/utcTimestamp" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "image", "digest"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "image": { "type": "string", "minLength": 1 },
          "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "file": { "type": "string", "minLength": 1 }
        }
      }
    },
    "compatibility": { "type": "object" },
    "migrations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "summary"],
      "properties": {
        "required": { "type": "boolean" },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "summary"],
      "properties": {
        "mode": { "enum": ["image-compatible", "restore-required"] },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "knownIssues": {
      "type": "array",
      "items": { "type": "string" }
    },
    "audiences": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["customer", "partner", "sejahome", "platform-only"] }
    },
    "actionRequired": { "type": "boolean" },
    "publicLinks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "url"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "pattern": "^https://" }
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "approvedBy", "approvedAt"],
      "properties": {
        "status": { "enum": ["pending", "approved"] },
        "approvedBy": { "type": "string" },
        "approvedAt": { "type": "string" }
      }
    }
  },
  "$defs": {
    "utcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
